[Unit]
Description=Holy Lois scoped closed-log retention
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/holylois-bot/routine.py
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/minecraft/logs /var/lib/holylois/retention-audit /run
